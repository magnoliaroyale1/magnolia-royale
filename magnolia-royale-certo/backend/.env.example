# preparar.cmd gera senhas aleatórias para a instalação local.
# Para um MySQL próprio, crie os bancos e ajuste estes endereços.
SECRET_KEY=substitua-por-uma-chave-aleatoria-longa
DATABASE_URL=mysql+pymysql://magnolia:SUA_SENHA@127.0.0.1:3306/magnolia_royale?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://magnolia:SUA_SENHA@127.0.0.1:3306/magnolia_royale_test?charset=utf8mb4
DEMO_MODE=1
FRONTEND_URL=http://127.0.0.1:5000
COOKIE_SECURE=0
